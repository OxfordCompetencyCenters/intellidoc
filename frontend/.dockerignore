# Frontend Docker Ignore File

# Node modules (match at any depth, not just the context root --
# a bare 'node_modules/' only excludes ./frontend/node_modules, which let
# the host's stale my-sveltekit-app/node_modules overwrite the image's)
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
build/
dist/
.svelte-kit/
.vite_cache/

# Cache
.cache/
.npm/
.eslintcache

# Environment files
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage
coverage/

# Testing
.nyc_output/

# Temporary
tmp/
temp/