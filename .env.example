# AI Catalogue Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_NAME=ai_catalogue_db
DB_USER=ai_catalogue_user
DB_PASSWORD=<REQUIRED-set-a-strong-password>   # no default; the old weak default was public
DB_HOST=postgres
DB_PORT=5432

# PostgreSQL tuning (applied in docker-compose.yml). Raise shared_buffers toward
# ~25% of host RAM on a larger machine.
DB_MAX_CONNECTIONS=200
DB_SHARED_BUFFERS=256MB
DB_EFFECTIVE_CACHE_SIZE=1GB
DB_WORK_MEM=8MB
DB_MAINTENANCE_WORK_MEM=128MB
DB_LOG_MIN_DURATION_MS=2000

# =============================================================================
# MILVUS VECTOR DATABASE CONFIGURATION
# =============================================================================
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Milvus Authentication (Required for v2.6.0+)
# Milvus only ever has its built-in "root" account — it does not create users,
# and nothing in this repository creates one. "milvusadmin" will NOT authenticate.
MILVUS_ROOT_USER=root
# Milvus ships with the default root password "Milvus", which is public. Change it
# on first run — scripts/bootstrap.sh does this for you — then set the new value here.
MILVUS_ROOT_PASSWORD=<REQUIRED-rotate-away-from-the-default-Milvus>

# MinIO Configuration (Required for Milvus v2.6.0+)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<REQUIRED-generate-below>   # required whenever DEBUG=False

# Set to False in production
DEBUG=True   # set False in production (settings default is False)

# Comma-separated list of allowed hosts
# Keep 'localhost' in this list: the container healthcheck and
# scripts/production.sh probe http://localhost:8000/health/, which
# resolves through Django and is rejected if the host is not allowed.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,nginx

# =============================================================================
# LLM API KEYS (Required for AI functionality)
# =============================================================================
# Google Gemini API for PDF/document processing
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API for content summarization and chat
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API for advanced reasoning
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate encryption keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=<generate-with-command-above>
PROJECT_API_KEY_ENCRYPTION_KEY=<generate-with-command-above>

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
# Disable tokenizer parallelism to prevent warnings
TOKENIZERS_PARALLELISM=false

# Enable MPS fallback for Apple Silicon
PYTORCH_ENABLE_MPS_FALLBACK=1

# Disable CUDA if not using GPU
CUDA_VISIBLE_DEVICES=

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Node environment
NODE_ENV=production

# Frontend port
FRONTEND_PORT=3000

# Backend API URL for server-side calls
BACKEND_URL=http://backend:8000

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
# Nginx port mappings
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to true to enable development containers with hot reload
DEVELOPMENT_MODE=false

# Frontend dev server port (only used in development)
FRONTEND_DEV_PORT=5173

# Backend dev server port (only used in development)  
BACKEND_DEV_PORT=8000

# ============================================================================
# ADDITIONAL VARIABLES READ BY docker-compose.yml
# All have working defaults in compose; set them to override.
# ============================================================================


# CORS / CSRF (comma-separated). Required for a real deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Service ports (all bound to 127.0.0.1 by compose; only nginx is public)
REDIS_PORT=6379

# Redis authentication (requirepass). REQUIRED — the cache holds fetched web
# content and rate-limit counters, so write access can poison LLM inputs.
REDIS_PASSWORD=<REQUIRED-generate-a-strong-password>

# Cache ceiling. Redis holds fetched web-page content; without a limit it grows
# unbounded and then rejects writes. Eviction is allkeys-lru (set in compose).
REDIS_MAXMEMORY=512mb
PGADMIN_PORT=8080
ATTU_PORT=3001

# Postgres auth method used on first init
DB_AUTH_METHOD=md5

# development | production
ENVIRONMENT=development

# Admin UIs
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=<set-a-strong-password>

# Browser-facing API base (point at your public origin in production)
VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api

# TLS (used by scripts/setup-ssl.sh and docker-compose.ssl.yml)
DOMAIN_NAME=
SSL_EMAIL=

# Email — password-reset links are delivered by email; the token is never
# returned in an API response. Console backend just logs the message.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@localhost
PASSWORD_RESET_BASE_URL=
